# Copy to `.env.local` (recommended; gitignored) or `.env`, then replace placeholders.
# Restart `npm run dev` after any change — Vite reads env only at startup.

# --- Hosted Supabase (Dashboard project) ---
VITE_LOCAL_TESTING=false
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the legacy anon public JWT (starts with eyJ…), NOT the publishable sb_publishable_… key, for email/password auth.
VITE_SUPABASE_ANON_KEY=
# If the dashboard only gives you sb_publishable_… for “anon”, paste the legacy JWT here instead:
# VITE_SUPABASE_ANON_JWT=eyJ...

# --- Local Supabase CLI (`supabase start`) — comment out the hosted block above when using this ---
# VITE_LOCAL_TESTING=true
# VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# VITE_SUPABASE_LOCAL_ANON_KEY=eyJ...   # from `supabase start` output

# --- Admin watchlist (optional) ---
# CLI: build SP500 + Yahoo snapshot without admin login (requires Watchlist API on 8000)
#   npm run watchlist:today
#   npm run watchlist:today -- --full
# Output default: ./watchlist under the repo root (same folder you open in Cursor).
# Override: WATCHLIST_CLI_OUTPUT_DIR=/home/you/SmartInvest/exports
# WATCHLIST_API_PORT=8000
# VITE_ADMIN_WATCHLIST_MAX_TICKERS=50
# VITE_WATCHLIST_FINANCIALS_CHUNK=8
# Reference data in browser only (IndexedDB) — reduces Supabase storage; no cross-device sync for these tables:
# VITE_LOCAL_STORAGE_TABLES=company_fundamentals,market_data

# --- Hugging Face (AI insights / sentiment — chat completions via router) ---
# If you see 403 “Inference Providers” / insufficient permissions, a *classic* read token is often not enough.
# Fix (fine-grained token):
#   1) https://huggingface.co/settings/tokens → Create new token → Type: Fine-grained
#   2) Under user permissions, enable BOTH if shown:
#      • “Make calls to the serverless Inference API” (Inference)
#      • “Make calls to Inference Providers” (or similar wording — HF renames UI occasionally)
#   3) Save the token, set below, restart `npm run dev`.
#   4) If you still get 403: https://huggingface.co/settings/inference-providers (routing / credits).
# Docs: https://huggingface.co/docs/inference-providers/en/index
# Alias env name also works: VITE_HUGGING_FACE_TOKEN
# VITE_HF_API_TOKEN=hf_...
# Optional: VITE_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# --- Google Gemini (alternative — API runs on Google; set key in Google AI Studio) ---
# VITE_LLM_PROVIDER=gemini
# VITE_GEMINI_API_KEY=
# Optional model id (default: gemini-2.5-flash-lite)
# VITE_GEMINI_MODEL=gemini-2.0-flash
# If primary hits limits, app retries (honors Google retry-after) then tries this model (default: gemini-2.5-flash — separate quota from flash-lite)
# VITE_GEMINI_MODEL_FALLBACK=gemini-2.5-flash
# Optional: if Gemini has network-level "Failed to fetch", fallback provider.
# Set one of: auto | hf | ollama | none (default auto: try ollama then hf)
# VITE_GEMINI_NETWORK_FALLBACK_PROVIDER=auto
# Browser calls are proxied through same-origin /gemini-api (vite.config) — avoids Google API CORS (“Failed to fetch”).
# App also tries /google-ai-api as an alias if one route is blocked by extensions/network policy.
# Only set this if you use your own gateway: VITE_GEMINI_BASE_URL=https://example.com/my-gemini-proxy
# Optional second gateway if same-origin `/gemini-api` fails (Failed to fetch)
# VITE_GEMINI_SECONDARY_BASE_URL=https://example.com/gemini-proxy
# Dev only: Vite proxy Node→Google TLS verify off when SSL inspection breaks outbound HTTPS (do not use in prod)
# VITE_GEMINI_PROXY_INSECURE_TLS=true
# Optional REST API version segment (default: v1beta)
# VITE_GEMINI_API_VERSION=v1beta
#
# --- Local Ollama (alternative to Hugging Face — uncomment; no HF token needed) ---
# After `ollama pull qwen2.5:7b`, keep Ollama running. Dev uses Vite proxy `/ollama` → 127.0.0.1:11434.
# VITE_LLM_PROVIDER=ollama
# VITE_OLLAMA_MODEL=qwen2.5:7b
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
