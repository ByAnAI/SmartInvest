# Copy to .env and fill in values. Never commit .env.

# false = hosted Supabase (VITE_SUPABASE_*). true = local CLI only (VITE_SUPABASE_LOCAL_*).
VITE_LOCAL_TESTING=false

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional local stack (`supabase start`)
# VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# VITE_SUPABASE_LOCAL_ANON_KEY=

# Optional
# VITE_WATCHLIST_API_URL=http://localhost:8000
# VITE_GEMINI_API_KEY=
# VITE_FINNHUB_KEY=

# Local LLM (Ollama) — CPU-only recommended on laptops with small GPUs
# VITE_LLM_PROVIDER=ollama
# VITE_SENTIMENT_SOURCE=alphavantage
# VITE_OLLAMA_MODEL=qwen2.5:3b
# VITE_OLLAMA_NUM_GPU=0
# Start Ollama: OLLAMA_NUM_GPU=0 ollama serve

# One-time: create admin@bts.com — use Legacy "service_role" JWT or "sb_secret_..." (never publishable key):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co SUPABASE_SERVICE_ROLE_KEY=eyJ... npm run ensure-admin
